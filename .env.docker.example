# Values for docker-compose.yml (local testing only).
# Copy to .env.docker and fill in. Use letters and numbers only for the
# Mongo passwords: they are placed inside a connection URL.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_root
MONGO_APP_USER=flatshare
MONGO_APP_PASSWORD=change_me_app
JWT_SECRET=replace_with_a_long_random_string

# development prints OTP codes to the backend logs when Brevo is not set.
NODE_ENV=development
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=FlatShare App
