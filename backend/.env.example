# FlatShare backend configuration
# Copy to .env and fill in real values. Never commit .env or put real
# secrets in this file.

# ── Server ─────────────────────────────────────────────
# Port the API listens on. Render sets this automatically; keep 5000 locally.
PORT=5000

# development locally; production on the deployed server (enables secure,
# cross-site cookies between the Vercel frontend and the Render API).
NODE_ENV=development

# Frontend origin(s) allowed by CORS, without a trailing slash.
# Comma-separate multiple origins.
# Production example: CLIENT_URL=https://flat-share-self.vercel.app
CLIENT_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Local MongoDB, or a MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flatshare?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/flatshare

# ── Authentication ─────────────────────────────────────
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=replace_with_a_long_random_string

# How long a login token stays valid (e.g. 12h, 7d). Keep it at 7d or less:
# the login cookie itself always expires after 7 days.
JWT_EXPIRES_IN=7d

# ── Email (OTP codes) ──────────────────────────────────
# Sent through the Brevo HTTP API (https://www.brevo.com); SMTP is blocked on
# Render's free tier. With NODE_ENV=development and these left empty, OTP
# codes are printed to the server console instead of being emailed.
# API key: Brevo → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key
# Must exactly match a sender verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM=your_verified_sender@example.com
# Display name on outgoing emails (optional).
EMAIL_FROM_NAME=FlatShare App
