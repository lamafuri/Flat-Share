PORT=5000
MONGODB_URI=mongodb://localhost:27017/flatshare
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
# Transactional email via Brevo (https://www.brevo.com) HTTP API.
# EMAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
# In development, leaving these empty prints OTP codes to the server console.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your_verified_sender@example.com
EMAIL_FROM_NAME=FlatShare App
# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
# Production example: CLIENT_URL=https://flat-share-self.vercel.app
CLIENT_URL=http://localhost:5173
# Set to production on the deployed server (enables cross-site secure cookies)
NODE_ENV=development
