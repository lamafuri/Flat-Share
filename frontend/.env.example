# FlatShare frontend configuration
# Copy to .env.local for local overrides. Vite embeds VITE_* values into the
# built JavaScript, so never put secrets here.

# Base URL of the backend, without /api and without a trailing slash.
# Defaults to http://localhost:5000 when unset.
# Production (Vercel project settings): VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=http://localhost:5000
